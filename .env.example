# RADAR MVP Environment Configuration Example
# Copy this file to .env and adjust the values for your environment.

# API Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/radar

# Frontend Vite Configuration
BASE_PATH=/

# External Providers (Server-side only)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
